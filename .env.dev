VITE_API_URL=https://dev-api.own-terra.com/api/v1
# Caddy de dev-api ya rutea /api/v1/communities|personas|... a properties-api
# (ver Caddyfile de core-back), así que esta URL es la misma que VITE_API_URL.
# Sin esto, el build de deploy caía al valor de .env.local (127.0.0.1:8013,
# pensado solo para levantar el front en tu máquina) porque Vite carga
# .env.local en CUALQUIER modo, no solo en "development" — rompía el módulo
# Properties/Comunidades en todo deploy (dev.own-terra.com y las previews).
VITE_PROPERTIES_API_URL=https://dev-api.own-terra.com/api/v1
VITE_BOT_API_URL=https://dev-bot-api.own-terra.com
VITE_SENTRY_DSN=https://5bb99d6911ec6940502fc42d72bd2f47@o4511515782086656.ingest.us.sentry.io/4511515787067392
