{
  "name": "lotemanager-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:react": "vitest run --environment jsdom",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:live": "playwright test --config=playwright.live.config.js",
    "test:e2e:live:headed": "playwright test --config=playwright.live.config.js --headed",
    "test:e2e:live:ui": "playwright test --config=playwright.live.config.js --ui",
    "preview": "vite preview",
    "sync:errors": "node scripts/sync-errors.mjs",
    "sync:errors:check": "node scripts/sync-errors.mjs --check"
  },
  "dependencies": {
    "@sentry/react": "^10.56.0",
    "@tanstack/react-query": "^5.59.20",
    "axios": "^1.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.1.1",
    "msw": "^2.7.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.19",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10"
  }
}
